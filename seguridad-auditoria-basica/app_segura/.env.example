# Plantilla de variables de entorno de la app segura.
# Como usarla:
#   1. copiar este archivo como ".env" (el .env NUNCA se sube al repositorio);
#   2. completar los valores vacios con los datos del despliegue;
#   3. en produccion, cargar estas variables desde el gestor de secretos del
#      hosting (Railway, Render, AWS, Vercel) y no desde archivos.
#
# Todos los valores de secretos quedan VACIOS a proposito: si se completion con
# un valor de ejemplo, ese valor termina publicado en el repositorio.
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_NAME=app_demo
API_KEY=
SECRET_JWT=
USER_DEMO_PASSWORD=
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000
DEBUG=False
PORT=8014
